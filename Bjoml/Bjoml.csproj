<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.ObjectPool" Version="10.0.9" />
    </ItemGroup>

    <ItemGroup>
      <!-- The regression tests need to observe parked operations to get a reliable
           "this fiber has suspended" signal. -->
      <InternalsVisibleTo Include="Tests" />
      <!-- The diagnostic harness benchmarks the direct TimeoutEvent against the
           retained combinator specification (Cml.TimeoutViaCombinators). -->
      <InternalsVisibleTo Include="Diag" />
    </ItemGroup>

</Project>
